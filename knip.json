{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/contentScripts/index.ts",
    "src/components/**",
    "scripts/*.ts",
    "*.config.*"
  ],
  "ignore": ["src/inject/**"],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css",
    "@vue/compiler-sfc",
    "@vue/language-core"
  ],
  "ignoreUnresolved": ["./scripts/manifest.ts"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
